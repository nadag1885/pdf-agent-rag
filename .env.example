# Copy this file to ".env" and fill in your real key.
# NEVER commit the real .env file.

# Which service generates answers: "google" (Gemini) or "groq"
LLM_PROVIDER=google

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=your_google_api_key_here
# Use a rolling alias: pinned versions like gemini-2.5-flash are not served to
# newly-created keys. Options: gemini-flash-latest, gemini-pro-latest,
# gemini-flash-lite-latest
GEMINI_MODEL=gemini-flash-latest

# --- Groq (https://console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: local cross-encoder reranker (downloads once, empty = disabled)
# RERANKER_MODEL=BAAI/bge-reranker-base
