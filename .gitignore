# ---- Secrets ----
.env
api_key.env
*.env
!.env.example

# ---- Vector database (ChromaDB persistent store) ----
# Published so a deployed app can answer immediately without re-indexing.
# It is built with the LOCAL embedding model; switching EMBEDDING_PROVIDER
# means rebuilding it, because vector dimensions must match.
# vectorstore/

# ---- Shared learned-answers store ----
learned_store/

# ---- Approved PDFs (admin-managed, not committed) ----
documents/*
!documents/.gitkeep
# Topic-organized source PDFs are published so the app is self-contained
# and any host can rebuild the index from scratch.
# data/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
pdf_venv/
*.egg-info/
.pytest_cache/

# ---- Local model / HF caches (optional, can be large) ----
.cache/

# ---- OS / editor temp files ----
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.log
*.swp
.idea/
.vscode/
